#!/usr/bin/env bash
set -euo pipefail

root=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
inventory="$root/inventories/production/hosts.yml"
variables="$root/inventories/production/group_vars/print_servers.yml"
backups="$root/.onboard-backups"
source "$root/scripts/lib/onboarding/prompts.sh"
source "$root/scripts/lib/onboarding/server-discovery.sh"
source "$root/scripts/lib/onboarding/ssh-session.sh"
source "$root/scripts/lib/onboarding/device-discovery.sh"
source "$root/scripts/lib/onboarding/device-decisions.sh"
source "$root/scripts/lib/onboarding/legacy-driver.sh"
source "$root/scripts/lib/onboarding/technical-output.sh"
ssh_socket=''
ssh_socket_dir=''
host_tmp=''
vars_tmp=''
direct_ethernet_interface=''
direct_ethernet_server_ipv4_cidr=''
direct_ethernet_device_ipv4=''
temporary_direct_connection=''
printer_candidates=()
scanner_candidates=()
discovery_tools_ready=false
discovery_ipp_usb_restore_needed=false
discovery_cups_restore_needed=false
discovery_ipp_usb_was_enabled='not-found'
discovery_ipp_usb_was_active='inactive'
reconfigure=false
TECHNICAL_VERBOSE=false

usage() {
  cat <<'EOF'
Configure a print and scan server.

Usage:
  scripts/onboard                 Start first setup, or manage devices when setup already exists
  scripts/onboard --reconfigure   Rebuild server-level settings and all device definitions
  scripts/onboard --verbose       Show complete captured technical output
  scripts/onboard -h, --help      Show this help
EOF
}

while (( $# > 0 )); do
  case "$1" in
    --reconfigure) reconfigure=true ;;
    --verbose) TECHNICAL_VERBOSE=true ;;
    -h|--help) usage; exit 0 ;;
    *) usage >&2; exit 2 ;;
  esac
  shift
done

if [[ -d "$root/.venv/bin" ]]; then
  PATH="$root/.venv/bin:$PATH"
fi
if ! command -v ansible-playbook >/dev/null 2>&1 || ! command -v ansible-galaxy >/dev/null 2>&1; then
  printf '%s\n' 'Ansible is not ready. Running the repository setup now.'
  "$root/scripts/setup"
  PATH="$root/.venv/bin:$PATH"
fi
ONBOARD_PYTHON="$root/.venv/bin/python"

saved_host_value() {
  local key=$1 fallback=$2 value
  value=$(awk -F': ' -v key="$key" '$1 ~ "^[[:space:]]*" key "$" {gsub(/^\"|\"$/, "", $2); print $2; exit}' "$inventory")
  printf '%s' "${value:-$fallback}"
}

configured_host=$(saved_host_value ansible_host '')
if [[ "$reconfigure" == false && -n "$configured_host" && "$configured_host" != 192.0.2.10 ]]; then
  printf 'Existing production configuration detected for %s.\n' "$configured_host"
  printf '%s\n' 'Routine additions, edits and deletions use the shorter device-management workflow.'
  if yes_default 'Open device management now?'; then
    if [[ "$TECHNICAL_VERBOSE" == true ]]; then
      exec "$root/scripts/manage-devices" --verbose
    fi
    exec "$root/scripts/manage-devices"
  fi
  printf '%s\n' 'No changes made. Use ./scripts/onboard --reconfigure to rebuild server-level settings.'
  exit 0
fi

cleanup() {
  [[ -n "$host_tmp" ]] && rm -f "$host_tmp"
  [[ -n "$vars_tmp" ]] && rm -f "$vars_tmp"
  [[ -n "$temporary_direct_connection" && -n "$ssh_socket" ]] && remote_tty "sudo nmcli connection delete $(printf '%q' "$temporary_direct_connection")" >/dev/null 2>&1 || true
  [[ "$discovery_ipp_usb_restore_needed" == true ]] && restore_ipp_usb_state
  [[ "$discovery_cups_restore_needed" == true ]] && restore_cups_state
  ssh_session_cleanup
  technical_transcript_finish
}

technical_transcript_start "$root" onboard
trap cleanup EXIT
trap 'exit 130' INT TERM

need ansible-playbook
need ansible-galaxy
need ssh
printf '%s\n' 'Print and scan server onboarding'
if [[ "$reconfigure" == true ]]; then
  printf '%s\n' 'Reconfiguring an already-commissioned server: server-level settings and every printer and scanner will be reviewed and rebuilt from scratch.'
fi
detail_block 'Before you begin' \
  'Inventory|Only non-secret values are written' \
  'Passwords|Requested only when needed and never stored' \
  'Tools|Bash, SSH and Ansible are ready'
printf '%s\n' '' 'This guided setup has five steps:' \
  '  1. Connect to the server and check administrator access.' \
  '  2. Confirm the trusted home network.' \
  '  3. Find connected printers and scanners.' \
  '  4. Choose the devices and their settings.' \
  '  5. Review everything before the server is changed.' \
  '' \
  'You can stop with Ctrl+C at any time. Discovery may install diagnostic packages before confirmation. Legacy driver inspection can install only its selected driver package before final queue confirmation. Production inventory, queues and services are changed only after final confirmation.'

stage '1 of 5' 'Connect to your server' 'Use the DHCP-reserved address or stable local DNS name so onboarding can find the same server again later.'
host_default=$(saved_host_value ansible_host print-server.local)
[[ "$host_default" == 192.0.2.10 ]] && host_default=print-server.local
if step_check administrator_cidr 'Detect the local network containing the server' 'local IPv4 route lookup' administrator_lan_cidr; then
  printf 'Detected local network: %s. A search checks private addresses for SSH port 22. It does not authenticate or change any device.\n' "$administrator_cidr"
else
  printf '%s\n' 'The local network could not be detected automatically. You can enter another private range to search, or enter the server address manually.'
fi
printf '\n'
input_required 'Network search'
if [[ -n "$administrator_cidr" ]]; then
  search_choice=$(ask_choice 'Where should the server be searched for?' 'detected' detected other skip)
else
  search_choice=$(ask_choice 'Where should the server be searched for?' 'other' other skip)
fi
if [[ "$search_choice" != skip ]]; then
  while true; do
    if [[ "$search_choice" == detected ]]; then
      search_cidr=$administrator_cidr
    else
      printf '%s\n' 'Enter the private network containing the server. At most 1,024 addresses are accepted, for example 192.168.178.0/24 or 10.20.4.0/23.'
      search_cidr=$(ask 'Private IPv4 network to search' '')
    fi
    valid_private_ipv4_search_cidr "$search_cidr" && break
    printf '%s\n' 'Invalid network range. Use an RFC1918 network address containing no more than 1,024 addresses.' >&2
  done
  if ! ssh_port_probe_available; then
    printf '%s\n' 'Automatic search needs netcat (nc) or timeout on this administrator machine. Enter the server address manually.' >&2
  else
    printf 'Searching %s now. Large ranges can take about one minute.\n' "$search_cidr"
    ssh_hosts=()
    ssh_search_output=''
    if ! step_check ssh_search_output 'Search for possible SSH hosts' "TCP port 22 probe across $search_cidr" find_ssh_hosts "$search_cidr"; then
      printf '%s\n' 'The network search failed. Enter the server address manually.' >&2
    fi
    while IFS= read -r ssh_host; do
      [[ -n "$ssh_host" ]] && ssh_hosts+=("$ssh_host")
    done <<<"$ssh_search_output"
    if (( ${#ssh_hosts[@]} == 0 )); then
      printf '%s\n' 'No SSH servers were detected. The server may be offline, outside the searched network or have SSH disabled. Enter its address manually.'
    elif (( ${#ssh_hosts[@]} == 1 )); then
      host_default=${ssh_hosts[0]}
      printf 'Detected one possible SSH host: %s. Press Enter below if this is the server.\n' "$host_default"
      printf '\n'
    else
      printf '%s\n' 'Detected multiple SSH servers. Select the server explicitly; the list can include other computers or network appliances.'
      candidate_count=0
      discovered_host=$(choose_candidate 'Possible SSH servers' "${ssh_hosts[@]}")
      [[ "$discovered_host" != manual ]] && host_default=$discovered_host
    fi
  fi
fi
input_required 'Connection'
while true; do
  host=$(ask 'Server hostname or IP address' "$host_default")
  resolution_output=''
  if step_check resolution_output 'Resolve the server address' "local IPv4 name lookup for $host" ssh_session_target_resolution "$host"; then
    break
  fi
  printf '%s\n' 'That server address could not be resolved to an IPv4 address on this computer.' >&2
  printf '%s\n' 'Use the DHCP-reserved IPv4 address, for example 192.168.178.33, or a stable local name such as print-server.local.' >&2
done
printf '%s\n' 'Use the bootstrap administrator account created when the server was provisioned. It is the account that installs and maintains printing services.'
while true; do
  admin=$(ask 'Bootstrap administrator user' "$(saved_host_value ansible_user printadmin)")
  [[ "$admin" =~ ^[a-z_][a-z0-9_-]*[$]?$ ]] && break
  printf '%s\n' 'Enter a valid Linux account name using lowercase letters, numbers, underscores or hyphens.' >&2
done
while true; do
  printf '%s\n' 'Connecting now. On a first connection, confirm the server host key. Then enter its password when SSH asks.'
  reachability_output=''
  step_check reachability_output 'Check local route and SSH reachability' "ip route get; TCP port 22 probe for $host" ssh_session_reachability "$host" || true
  if step_check_live 'Open the server SSH session' "ssh control connection to $admin@$host" ssh_session_open &&
     step_check remote_shell_output 'Verify the server remote shell' 'ssh remote true' remote true &&
     step_check_live 'Verify server administrator privileges' 'sudo -v' remote_tty 'sudo -v'; then
    break
  fi
  printf '%s\n' 'The server connection or sudo check failed. Check the address, bootstrap user, password and SSH settings.' >&2
  printf 'Choose retry to try the same address and user again, or correct to re-enter them.\n' >&2
  recovery=$(recovery_choice 'Connection recovery (retry, correct, stop)' retry retry correct stop) || exit 1
  case "$recovery" in
    retry) ssh_session_cleanup ;;
    correct)
      ssh_session_cleanup
      host=$(ask 'Server hostname or IP address' "$host")
      admin=$(ask 'Bootstrap administrator user' "$admin")
      ;;
    stop) exit 1 ;;
  esac
done
printf '%s\n' 'The password is not stored.'
printf '\n'
stage '2 of 5' 'Confirm your trusted network' 'Reading the server network, timezone and locale now. Only devices on the trusted network will later reach printing and scanning.' "Server $admin@$host"
step_check suggested_cidr 'Detect the server trusted-LAN route' 'ip route show default; ip route show dev <interface> proto kernel scope link' \
  remote 'interface=$(ip -4 route show default | awk '\''{print $5; exit}'\''); ip -4 route show dev "$interface" proto kernel scope link | awk '\''$1 ~ /\// {print $1; exit}'\''' || true
step_check timezone 'Detect the server timezone' 'cat /etc/timezone; timedatectl show --property=Timezone' \
  remote 'cat /etc/timezone 2>/dev/null || timedatectl show --property=Timezone --value' || true
step_check locale 'Detect the server locale' 'locale' \
  remote "locale | awk -F= '/^LANG=/{print \$2; exit}'" || true
timezone=${timezone:-"$(saved_scalar common_timezone Europe/Berlin)"}
locale=${locale:-"$(saved_scalar common_locale en_US.UTF-8)"}
printf 'Detected server settings: IPv4 network %s, timezone %s, locale %s.\n' "${suggested_cidr:-not detected}" "$timezone" "$locale"
printf '%s\n' 'The detected timezone and locale were set during provisioning and will be kept. No input is needed for them.'
setting_group 'Trusted IPv4 LAN'
printf '%s\n' 'Choose the normal home-LAN subnet. A CIDR is the whole network range, for example 192.168.178.0/24, not the server address. Accept the suggestion unless printing clients use another trusted VLAN.'
while true; do
  cidr=$(ask_detected 'Trusted IPv4 LAN CIDR' "${suggested_cidr:-192.168.1.0/24}" 'Do not enter the server address itself.')
  valid_ipv4_cidr "$cidr" && break
  printf '%s\n' 'Invalid IPv4 CIDR. Use four numbers from 0 to 255 followed by /0 to /32, for example 192.168.178.0/24.' >&2
done
setting_group 'Trusted IPv6 LAN (optional)'
printf '%s\n' 'Leave IPv6 empty unless the home network actively uses a known local IPv6 prefix.'
while true; do
  ipv6_cidr=$(ask 'Optional trusted IPv6 CIDR' '')
  [[ -z "$ipv6_cidr" ]] || valid_ipv6_cidr "$ipv6_cidr" && break
  printf '%s\n' 'Invalid IPv6 CIDR. Use a local IPv6 prefix followed by /0 to /128, or leave it empty.' >&2
done
confirmation_block 'Trusted network' "IPv4|$cidr" "IPv6|${ipv6_cidr:-not configured}" "Timezone|$timezone" "Locale|$locale"
printf '\n' >&2
input_required 'Server identity'
while true; do
  hostname=$(ask 'Server hostname' "$(saved_scalar common_hostname print-server)")
  [[ "$hostname" =~ ^[a-zA-Z0-9][a-zA-Z0-9-]{0,62}$ ]] && break
  printf '%s\n' 'Use 1 to 63 letters, numbers or hyphens, starting with a letter or number.' >&2
done
authorized_key=''
for public_key_path in "$HOME/.ssh/id_ed25519.pub" "$HOME/.ssh/id_ecdsa.pub" "$HOME/.ssh/id_rsa.pub"; do
  if [[ -r "$public_key_path" ]]; then
    authorized_key=$(<"$public_key_path")
    printf 'Detected administrator SSH public key: %s. It will be installed for passwordless future connections.\n' "$public_key_path"
    break
  fi
done
[[ -n "$authorized_key" ]] || printf '%s\n' 'No standard SSH public key was found. Password SSH remains available.'
stage '3 of 5' 'Find printers and scanners' 'Discovery can suggest settings for devices on this trusted LAN and directly connected USB devices. It never selects or configures a device without you.' "Server $admin@$host · trusted LAN $cidr"
input_required 'Discovery scope'
discovery_scope=$(ask_choice 'Which connections to search?' 'all' all lan usb skip)
discover_devices false "$discovery_scope"
discovery_tools_ready=true
stage '4 of 5' 'Choose your devices' 'The selections here become the saved configuration used for later maintenance. Keep the suggested names unless another name is clearer in your home network.' "Server $admin@$host · trusted LAN $cidr"
printer_queues=()
printer_connections=()
printer_uris=()
printer_drivers=()
printer_profiles=()
printer_identity_evidences=()
printer_cups_models=()
printer_usb_modes=()
printer_usb_identities=()
printer_dns_sd_names=()
scanner_device_names=()
scanner_display_names=()
scanner_connections=()
scanner_backends=()
scanner_backend_installs=()
scanner_usb_modes=()
scanner_usb_identities=()

subsection 'Devices'
printf '%s\n' 'Add printers and scanners one at a time. A multifunction device with different connections for printing and scanning (for example USB printing with network scanning) is added as one printer and one scanner.'
while true; do
  default_action=done
  (( ${#printer_candidates[@]} > 0 )) && default_action=printer
  (( ${#printer_candidates[@]} == 0 && ${#scanner_candidates[@]} > 0 )) && default_action=scanner
  action=$(ask_choice 'Add a device?' "$default_action" printer scanner done)
  if [[ "$action" == done ]]; then
    if (( ${#printer_queues[@]} == 0 && ${#scanner_device_names[@]} == 0 )); then
      printf '%s\n' 'At least one device is required before continuing.' >&2
      continue
    fi
    break
  fi
  if ! select_or_collect_device "$action"; then
    continue
  fi
  printf '\n' >&2
  if [[ "$action" == printer ]]; then
    printer_queues+=("$COLLECTED_PRINTER_QUEUE")
    printer_connections+=("$COLLECTED_PRINTER_CONNECTION")
    printer_uris+=("$COLLECTED_PRINTER_URI")
    printer_drivers+=("$COLLECTED_PRINTER_DRIVER")
    printer_profiles+=("$COLLECTED_PRINTER_PROFILE")
    printer_identity_evidences+=("$COLLECTED_PRINTER_IDENTITY_EVIDENCE")
    printer_cups_models+=('')
    printer_usb_modes+=("$COLLECTED_PRINTER_USB_MODE")
    printer_usb_identities+=("$COLLECTED_PRINTER_USB_IDENTITY")
    printer_dns_sd_names+=("$COLLECTED_PRINTER_DNS_SD_NAME")
  else
    scanner_device_names+=("$COLLECTED_SCANNER_DEVICE_NAME")
    scanner_display_names+=("$COLLECTED_SCANNER_DISPLAY_NAME")
    scanner_connections+=("$COLLECTED_SCANNER_CONNECTION")
    scanner_backends+=("$COLLECTED_SCANNER_BACKEND")
    scanner_backend_installs+=("$COLLECTED_SCANNER_BACKEND_INSTALL")
    scanner_usb_modes+=("$COLLECTED_SCANNER_USB_MODE")
    scanner_usb_identities+=("$COLLECTED_SCANNER_USB_IDENTITY")
  fi
done

for index in "${!printer_queues[@]}"; do
  for other_index in "${!printer_queues[@]}"; do
    (( other_index >= index )) && continue
    [[ "${printer_queues[$index]}" != "${printer_queues[$other_index]}" ]] || {
      printf 'Duplicate queue name: %s\n' "${printer_queues[$index]}" >&2
      exit 1
    }
  done
done

# A package profile identifies a generic Debian driver package. The exact PPD/model is
# deliberately selected from this server after that package is prepared.
if [[ " ${printer_drivers[*]} " == *' package_profile '* ]]; then
  group_header 'Prepare Legacy Drivers'
  host_tmp=$(mktemp "${inventory%.yml}.XXXXXX.yml")
  printf '%s\n' '---' 'all:' '  children:' '    print_servers:' '      hosts:' '        print-server:' "          ansible_host: $(quote "$host")" "          ansible_user: $(quote "$admin")" '          ansible_become: true' >"$host_tmp"
  legacy_driver_inventory=$host_tmp
  for index in "${!printer_queues[@]}"; do
    [[ "${printer_drivers[$index]}" == package_profile ]] || continue
    printf 'Preparing the legacy model choice for queue %s.\n' "${printer_queues[$index]}" >&2
    prepare_legacy_printer_model "${printer_profiles[$index]}" "${printer_uris[$index]}" "${printer_identity_evidences[$index]}" || {
      printf '%s\n' 'A CUPS model must be selected for every package-profile printer before commissioning.' >&2
      exit 1
    }
    printer_cups_models[$index]=$COLLECTED_PRINTER_CUPS_MODEL
    printer_profiles[$index]=$COLLECTED_PRINTER_PROFILE
    confirmation_block "Printer: ${printer_queues[$index]}" "Profile|${printer_profiles[$index]}" "Model|${printer_cups_models[$index]}"
  done
  rm -f "$host_tmp"
  host_tmp=''
fi

stage '5 of 5' 'Review and commission' 'Review the configuration below before it is written locally or applied to the server.' "Server $admin@$host · trusted LAN $cidr · ${#printer_queues[@]} printer(s)"
direct_ethernet_summary='not configured'
[[ -n "$direct_ethernet_interface" ]] && direct_ethernet_summary="$direct_ethernet_interface ($direct_ethernet_server_ipv4_cidr -> $direct_ethernet_device_ipv4)"
confirmation_block 'Server' \
  "Server|$admin@$host" "Hostname|$hostname" "Trusted LAN|$cidr" "Trusted IPv6|${ipv6_cidr:-not configured}" \
  "Timezone|$timezone" "Locale|$locale" "Direct Ethernet|$direct_ethernet_summary" \
  "SSH key install|$([[ -n "$authorized_key" ]] && printf yes || printf no)"
for index in "${!printer_queues[@]}"; do
  printf '\n' >&2
  confirmation_block "Printer: ${printer_queues[$index]}" \
    "Connection|${printer_connections[$index]}" "URI|${printer_uris[$index]}" "Driver|${printer_drivers[$index]}" \
    "Profile|${printer_profiles[$index]:-not applicable}" "Model|${printer_cups_models[$index]:-not applicable}" \
    "USB mode|${printer_usb_modes[$index]:-not applicable}" "USB ID|${printer_usb_identities[$index]:-not applicable}" \
    "DNS-SD name|${printer_dns_sd_names[$index]}"
done
if (( ${#scanner_device_names[@]} > 0 )); then
  for index in "${!scanner_device_names[@]}"; do
    printf '\n' >&2
    confirmation_block "Scanner: ${scanner_device_names[$index]}" \
      "Display name|${scanner_display_names[$index]}" "Connection|${scanner_connections[$index]}" "Backend|${scanner_backends[$index]}" \
      "Backend install|${scanner_backend_installs[$index]}" "USB mode|${scanner_usb_modes[$index]:-not applicable}" \
      "USB ID|${scanner_usb_identities[$index]:-not applicable}"
  done
  printf '\n' >&2
  confirmation_block 'ScanservJS' "Retention|$retention days" "OCR|$ocr" "Port|$scanservjs_port" "Page splitting|$page_splitting"
fi
printf '\n' >&2
printf '%s\n' 'Confirmation creates local inventory backups, replaces the declared device lists and starts Ansible provisioning on the server.'
printf '%s\n' 'No passwords are written to inventory. Choose no to exit without changing inventory or server services.'
yes 'Write production inventory and commission the server?' || exit 0

host_tmp=$(mktemp "$inventory.XXXXXX")
vars_tmp=$(mktemp "$variables.XXXXXX")
printf '%s\n' '---' 'all:' '  children:' '    print_servers:' '      hosts:' '        print-server:' "          ansible_host: $(quote "$host")" "          ansible_user: $(quote "$admin")" '          ansible_become: true' >"$host_tmp"
{
  printf '%s\n' '---'
  printf 'common_hostname: %s\ncommon_timezone: %s\ncommon_locale: %s\n' "$(quote "$hostname")" "$(quote "$timezone")" "$(quote "$locale")"
  printf 'managed_users:\n  - name: %s\n    groups: [sudo]\n    sudo: true\n' "$(quote "$admin")"
  if [[ -n "$authorized_key" ]]; then
    printf '    authorized_keys:\n      - %s\n' "$(quote "$authorized_key")"
  fi
  printf 'ssh_allow_password_authentication: true\nfirewall_enabled: true\ntrusted_lan_cidrs:\n  - %s\n' "$(quote "$cidr")"
  [[ -n "$ipv6_cidr" ]] && printf '  - %s\n' "$(quote "$ipv6_cidr")"
  if [[ -n "$direct_ethernet_interface" ]]; then
    printf 'direct_ethernet_links:\n  - interface: %s\n    server_ipv4_cidr: %s\n    device_ipv4: %s\n' \
      "$(quote "$direct_ethernet_interface")" "$(quote "$direct_ethernet_server_ipv4_cidr")" "$(quote "$direct_ethernet_device_ipv4")"
  else
    printf '%s\n' 'direct_ethernet_links: []'
  fi
  printf '%s\n' 'managed_printers:'
  for index in "${!printer_queues[@]}"; do
    printf '  - name: %s\n    connection: %s\n    device_uri: %s\n    driver_mode: %s\n    shared: true\n' \
      "$(quote "${printer_queues[$index]}")" "$(quote "${printer_connections[$index]}")" \
      "$(quote "${printer_uris[$index]}")" "$(quote "${printer_drivers[$index]}")"
    [[ -n "${printer_profiles[$index]}" ]] && printf '    package_profile: %s\n' "$(quote "${printer_profiles[$index]}")"
    [[ -n "${printer_cups_models[$index]}" ]] && printf '    cups_model: %s\n' "$(quote "${printer_cups_models[$index]}")"
    [[ -n "${printer_usb_modes[$index]}" ]] && printf '    usb_mode: %s\n' "$(quote "${printer_usb_modes[$index]}")"
    [[ -n "${printer_usb_identities[$index]}" ]] && printf '    usb_identity: %s\n' "$(quote "${printer_usb_identities[$index]}")"
    [[ "${printer_dns_sd_names[$index]}" != "${printer_queues[$index]}" ]] && printf '    dns_sd_name: %s\n' "$(quote "${printer_dns_sd_names[$index]}")"
  done
  if (( ${#scanner_device_names[@]} > 0 )); then
    languages=$(printf '%s' "$ocr" | sed 's/[[:space:]]*,[[:space:]]*/, /g; s/[^, ][^, ]*/"&"/g')
    printf '%s\n' 'managed_scanners:'
    for index in "${!scanner_device_names[@]}"; do
      printf '  - device_name: %s\n    connection: %s\n    backend: %s\n' \
        "$(quote "${scanner_device_names[$index]}")" "$(quote "${scanner_connections[$index]}")" "$(quote "${scanner_backends[$index]}")"
      [[ "${scanner_backend_installs[$index]}" == false ]] && printf '%s\n' '    backend_install: false'
      [[ -n "${scanner_usb_modes[$index]}" ]] && printf '    usb_mode: %s\n' "$(quote "${scanner_usb_modes[$index]}")"
      [[ -n "${scanner_usb_identities[$index]}" ]] && printf '    usb_identity: %s\n' "$(quote "${scanner_usb_identities[$index]}")"
      [[ "${scanner_display_names[$index]}" != "${scanner_device_names[$index]}" ]] && printf '    display_name: %s\n' "$(quote "${scanner_display_names[$index]}")"
    done
    printf 'scanservjs_retention_days: %s\nscanservjs_ocr_languages: [%s]\nscanservjs_port: %s\n' "$retention" "$languages" "$scanservjs_port"
    printf 'scanservjs_page_splitting: %s\n' "$page_splitting"
  else
    printf '%s\n' 'managed_scanners: []'
  fi
  printf '%s\n' 'enable_remote_sane: false' 'enable_unattended_upgrades: false'
} >"$vars_tmp"
resolve_catalog_identity || true
catalog_arguments=()
mapfile -t catalog_arguments < <(catalog_identity_arguments)
step_action inventory_write_output 'Write confirmed production inventory' 'device_inventory.py write-initial' \
  "$root/.venv/bin/python" "$root/scripts/lib/device_inventory.py" "${catalog_arguments[@]}" --inventory "$variables" \
  --host-inventory "$inventory" --backup-directory "$backups" write-initial \
  --host-document "$host_tmp" --variables-document "$vars_tmp"
rm -f "$host_tmp" "$vars_tmp"
host_tmp=''
vars_tmp=''
subsection 'Applying Your Configuration'
printf '%s\n' 'Your confirmed choices are now being applied. Ansible will show its normal progress while it installs services and configures the declared queues and scanners.'
while ! step_stream galaxy_output 'Install pinned Ansible collections' 'ansible-galaxy collection install' \
  ansible-galaxy collection install -r "$root/requirements.yml"; do
  printf 'Collection installation failed. Technical transcript: %s\n' "$technical_transcript" >&2
  printf 'Choose manage to exit this wizard and fix device definitions with scripts/manage-devices instead of finishing this setup run.\n' >&2
  recovery=$(recovery_choice 'Collection recovery (retry, manage, stop)' retry retry manage stop) || exit 1
  if [[ "$recovery" == retry ]]; then
    ssh_session_cleanup
    ssh_session_open
    continue
  fi
  [[ "$recovery" == manage ]] && exec "$root/scripts/manage-devices"
  exit 1
done
ansible_arguments=(-i "$inventory" "$root/playbooks/site.yml" -e print_server_commissioning=true)
if ! remote 'sudo -n true' >/dev/null 2>&1; then
  printf '%s\n' 'Ansible needs the server sudo password once for commissioning.'
  ansible_arguments+=(--ask-become-pass)
fi
ansible_output=''
while ! step_stream ansible_output 'Commission the server with Ansible' 'ansible-playbook playbooks/site.yml' \
  env ANSIBLE_SSH_ARGS="-o ControlMaster=auto -o ControlPath=$ssh_socket" ansible-playbook "${ansible_arguments[@]}"; do
  printf 'Commissioning failed. Technical transcript: %s\n' "$technical_transcript" >&2
  manual_recovery_command "$root" "$variables" "$inventory" playbooks/site.yml -e print_server_commissioning=true
  printf 'Choose manage to exit this wizard and fix device definitions with scripts/manage-devices instead of finishing this setup run.\n' >&2
  recovery=$(recovery_choice 'Commissioning recovery (retry, manage, stop)' retry retry manage stop) || exit 1
  if [[ "$recovery" == retry ]]; then
    ssh_session_cleanup
    ssh_session_open
    continue
  fi
  [[ "$recovery" == manage ]] && exec "$root/scripts/manage-devices"
  exit 1
done
printf '%s\n' 'Commissioning completed successfully.'
verify_ipp_listener_ready true || exit 1
dns_sd_advertised_count=0
for index in "${!printer_queues[@]}"; do
  verify_dns_sd_name_advertised true "${printer_dns_sd_names[$index]}" && ((++dns_sd_advertised_count)) || true
done
if (( ${#printer_queues[@]} > 0 )); then
  printf '%d of %d printer(s) advertised their DNS-SD name.\n' "$dns_sd_advertised_count" "${#printer_queues[@]}"
fi
for driver in "${printer_drivers[@]}"; do
  if [[ "$driver" == package_profile ]]; then
    printf '%s\n' 'Reporting repository package-profile matches for each commissioned legacy (package-profile) printer.'
    discover_printer_output=''
    step_check discover_printer_output 'Report repository package-profile matches' 'ansible-playbook playbooks/discover-printer.yml' \
      env ANSIBLE_SSH_ARGS="-o ControlMaster=auto -o ControlPath=$ssh_socket" ansible-playbook -i "$inventory" "$root/playbooks/discover-printer.yml" || true
    break
  fi
done
if yes 'Print CUPS test pages now?'; then
  for queue in "${printer_queues[@]}"; do
    verify_cups_job "$queue"
  done
fi
if (( ${#scanner_device_names[@]} > 0 )); then
  verify_scanservjs_ready "$scanservjs_port" || true
fi
if (( ${#scanner_device_names[@]} > 0 )) && yes 'Create scanner test PDFs now? This can use paper or move a scanner.'; then
  scanner_test_pdfs_created=0
  for index in "${!scanner_device_names[@]}"; do
    create_scanner_test_pdf "${scanner_device_names[$index]}" "$((index + 1))" && ((++scanner_test_pdfs_created)) || true
  done
  printf 'Created %d of %d scanner test PDF(s) under /var/tmp on %s.\n' "$scanner_test_pdfs_created" "${#scanner_device_names[@]}" "$host"
fi
printf '\n' >&2
group_header 'Onboarding complete'
printf '%s\n' "Server: $admin@$host (hostname $hostname)" >&2
for index in "${!printer_queues[@]}"; do
  printf '  Printer: %s (DNS-SD name %s)\n' "${printer_queues[$index]}" "${printer_dns_sd_names[$index]}" >&2
done
if (( ${#scanner_device_names[@]} > 0 )); then
  for index in "${!scanner_device_names[@]}"; do
    printf '  Scanner: %s\n' "${scanner_display_names[$index]}" >&2
  done
  printf '  ScanservJS: http://%s:%s (retention %s days)\n' "$host" "$scanservjs_port" "$retention" >&2
fi
printf '%s\n' 'Run ./scripts/manage-devices to add, edit or remove a device later.' >&2
