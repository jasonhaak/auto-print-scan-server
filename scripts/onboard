#!/usr/bin/env bash
set -euo pipefail

root=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
inventory="$root/inventories/production/hosts.yml"
variables="$root/inventories/production/group_vars/print_servers.yml"
backups="$root/.onboard-backups"
source "$root/scripts/lib/onboarding/prompts.sh"
source "$root/scripts/lib/onboarding/server-discovery.sh"
source "$root/scripts/lib/onboarding/ssh-session.sh"
ssh_socket=''
ssh_socket_dir=''
host_tmp=''
vars_tmp=''
direct_ethernet_interface=''
direct_ethernet_pi_ipv4_cidr=''
direct_ethernet_device_ipv4=''
temporary_direct_connection=''

cleanup() {
  [[ -n "$host_tmp" ]] && rm -f "$host_tmp"
  [[ -n "$vars_tmp" ]] && rm -f "$vars_tmp"
  [[ -n "$temporary_direct_connection" && -n "$ssh_socket" ]] && remote_tty "sudo nmcli connection delete $(printf '%q' "$temporary_direct_connection")" >/dev/null 2>&1 || true
  ssh_session_cleanup
}

discover_direct_ethernet_device() {
  local scanner_output line scanner_identifier
  recommendation 'Temporarily configure the private Ethernet link now. It is removed after discovery; the same link is recreated only after final confirmation.'
  yes 'Temporarily configure the direct Ethernet link and search this device?' || return
  temporary_direct_connection="raspberry-print-server-onboarding-${BASHPID}"
  if ! remote_tty "sudo nmcli connection add type ethernet ifname $(printf '%q' "$direct_ethernet_interface") con-name $(printf '%q' "$temporary_direct_connection") ipv4.method manual ipv4.addresses $(printf '%q' "$direct_ethernet_pi_ipv4_cidr") ipv4.never-default yes ipv6.method disabled && sudo nmcli connection up $(printf '%q' "$temporary_direct_connection")" >/dev/null; then
    printf '%s\n' 'The private Ethernet link could not be configured. Check the cable, interface name and Raspberry Pi NetworkManager status. Continue with manual device details.' >&2
    remote_tty "sudo nmcli connection delete $(printf '%q' "$temporary_direct_connection")" >/dev/null 2>&1 || true
    temporary_direct_connection=''
    return
  fi
  if remote "ipptool -tv $(printf '%q' "ipp://${direct_ethernet_device_ipv4}/ipp/print") get-printer-attributes.test" >/dev/null 2>&1; then
    discovered_printer_connection=ipp
    discovered_printer_uri="ipp://${direct_ethernet_device_ipv4}/ipp/print"
    printf 'Detected an IPP printer at %s. Its connection and URI are recommended below.\n' "$direct_ethernet_device_ipv4"
  else
    printf 'No IPP printer responded at %s. You can still enter another printer protocol and URI manually.\n' "$direct_ethernet_device_ipv4" >&2
  fi
  scanner_output=$(remote 'airscan-discover 2>&1; scanimage -L 2>&1' || true)
  while IFS= read -r line; do
    [[ "$line" == device* ]] || continue
    scanner_identifier=${line#device \`}
    scanner_identifier=${scanner_identifier%%\'*}
    [[ -n "$scanner_identifier" ]] || continue
    discovered_scanner=true
    discovered_scanner_connection=ipp
    discovered_scanner_backend=sane-airscan
    discovered_scanner_usb_mode=''
    discovered_scanner_device_name=$scanner_identifier
    printf 'Detected a network scanner: %s. It will be recommended in the scanner section.\n' "$scanner_identifier"
    break
  done <<<"$scanner_output"
  remote_tty "sudo nmcli connection delete $(printf '%q' "$temporary_direct_connection")" >/dev/null 2>&1 || true
  temporary_direct_connection=''
}

discover_devices() {
  local discovery_log install_log network_output usb_output usb_devices ipp_usb_output scanner_output ipp_query_output='' query_output line scanner_identifier event interface protocol name service domain device_host address port txt rp scheme uri choice temporary_ipp_usb=false
  local -a printer_candidates=() scanner_candidates=()
  discovery_log=$(mktemp "${TMPDIR:-/tmp}/raspberry-print-server-discovery.XXXXXX.log")
  printf '%s\n' 'Discovery can find printers and scanners that are visible on the trusted LAN or connected by USB.'
  recommendation 'Install the discovery tools. They are needed only on the Raspberry Pi and do not configure a device.'
  if ! yes 'Install temporary discovery tools to find printers and scanners?'; then
    rm -f "$discovery_log"
    return
  fi
  printf '%s\n' 'Installing discovery tools. This can take a few minutes on the first run.'
  install_log=$(mktemp "${TMPDIR:-/tmp}/raspberry-print-server-discovery-install.XXXXXX.log")
  if ! remote_tty 'sudo -v && sudo apt-get update && sudo env DEBIAN_FRONTEND=noninteractive apt-get install -y avahi-utils cups-ipp-utils sane-utils sane-airscan ipp-usb && { sudo systemctl disable --now ipp-usb.service >/dev/null 2>&1 || true; }' >"$install_log" 2>&1; then
    printf '%s\n' 'Discovery tools could not be installed. Continue with manual configuration.' >&2
    cat "$install_log" >&2
    rm -f "$install_log"
    rm -f "$discovery_log"
    return
  fi
  rm -f "$install_log"
  printf '%s\n' 'Discovery tools are ready. Searching local network announcements and connected USB devices for up to 15 seconds.'

  usb_output=$(remote 'lsusb' 2>&1 || true)
  usb_devices=$(usb_device_descriptions "$usb_output")
  if ipp_usb_output=$(remote 'sudo ipp-usb check' 2>&1); then
    if remote_tty 'sudo systemctl start ipp-usb.service'; then
      temporary_ipp_usb=true
      trap 'remote "sudo systemctl disable --now ipp-usb.service" >/dev/null 2>&1 || true; exit 130' INT TERM
    fi
    printer_candidates+=("USB IPP-over-USB printer${usb_devices:+ — ${usb_devices//$'\n'/; }}|usb|ipp://localhost:60000/ipp/print|ipp_usb")
  fi
  network_output=$(remote 'timeout 15s avahi-browse -artp' 2>&1 || true)
  scanner_output=$(remote 'airscan-discover 2>&1; scanimage -L 2>&1' || true)
  if [[ "$temporary_ipp_usb" == true ]]; then
    remote_tty 'sudo systemctl disable --now ipp-usb.service' >/dev/null 2>&1 || true
    trap 'exit 130' INT TERM
  fi
  while IFS=';' read -r event interface protocol name service domain device_host address port txt; do
    [[ "$event" == '=' ]] || continue
    case "$service" in
      _ipp._tcp|_ipps._tcp)
        scheme=${service#_}
        scheme=${scheme%%._tcp}
        rp=$(printf '%s' "$txt" | sed -nE 's/.*rp=([^" ]+).*/\1/p' | head -n 1)
        rp=${rp:-ipp/print}
        uri="$scheme://$address:$port/$rp"
        if query_output=$(remote "ipptool -tv $(printf '%q' "$uri") get-printer-attributes.test" 2>&1); then
          printer_candidates+=("$name at $address:$port ($scheme)|$scheme|$uri|")
        else
          ipp_query_output+="$name at $address:$port: $query_output"$'\n'
        fi
        ;;
      _uscan._tcp|_scanner._tcp)
        scanner_candidates+=("$name at $address:$port ($service, sane-airscan)|ipp|sane-airscan|")
        ;;
    esac
  done <<<"$network_output"
  while IFS= read -r line; do
    [[ "$line" == device* ]] || continue
    scanner_identifier=${line#device \`}
    scanner_identifier=${scanner_identifier%%\'*}
    if [[ "$scanner_identifier" == airscan:* ]]; then
      scanner_candidates+=("$scanner_identifier (SANE AirScan detected)|ipp|sane-airscan|")
    else
      scanner_candidates+=("$scanner_identifier (SANE detected)|usb|sane-utils|legacy_usb")
    fi
  done <<<"$scanner_output"
  {
    printf '%s\n%s\n%s\n%s\n' 'Network discovery:' "$network_output" 'USB discovery:' "$usb_output"
    printf '%s\n%s\n%s\n%s\n%s\n%s\n' 'IPP-over-USB check:' "$ipp_usb_output" 'IPP queries:' "$ipp_query_output" 'SANE discovery:' "$scanner_output"
  } >"$discovery_log"

  printf 'Discovery completed: %d printer candidate(s), %d scanner candidate(s).\n' "${#printer_candidates[@]}" "${#scanner_candidates[@]}"

  if (( ${#printer_candidates[@]} == 0 )); then
    printf '%s\n' 'No printer was found. For manual setup, find the printer IPP address in its web administration page or manual. A common example is ipp://192.168.178.50/ipp/print.'
  fi
  if (( ${#scanner_candidates[@]} == 0 )); then
    printf '%s\n' 'No scanner was found. For manual setup, connect it, then run scanimage -L on the Raspberry Pi and copy the device line it reports.'
  fi

  if (( ${#printer_candidates[@]} > 0 )); then
    candidate_count=0
    choice=$(choose_candidate 'Discovered printers. Select the device to configure or enter details manually.' "${printer_candidates[@]}")
    if [[ "$choice" != manual ]]; then
      IFS='|' read -r selected_printer_label discovered_printer_connection discovered_printer_uri discovered_printer_usb_mode <<<"$choice"
      printf 'Selected detected printer: %s. Its connection and URI will be suggested below; press Enter only when they match this printer.\n' "$selected_printer_label"
    fi
  fi
  if (( ${#scanner_candidates[@]} > 0 )); then
    candidate_count=0
    choice=$(choose_candidate 'Discovered scanners. Select one to configure or enter details manually.' "${scanner_candidates[@]}")
    if [[ "$choice" != manual ]]; then
      IFS='|' read -r selected_scanner_label discovered_scanner_connection discovered_scanner_backend discovered_scanner_usb_mode <<<"$choice"
      discovered_scanner=true
      printf 'Selected detected scanner: %s. Its connection and backend will be used; you will still enter its exact SANE device name before commissioning.\n' "$selected_scanner_label"
    fi
  fi
  if [[ -z "${discovered_printer_connection:-}" && -z "${discovered_scanner:-}" ]]; then
    printf 'No usable device was selected. Continue with manual configuration. Diagnostic log: %s\n' "$discovery_log" >&2
  else
    rm -f "$discovery_log"
  fi
}

need ansible-playbook
need ansible-galaxy
need ssh
printf '%s\n' 'Raspberry Pi print and scan server onboarding'
printf '%s\n' 'Only non-secret inventory values are written. Ansible prompts for passwords when required.'
printf '%s\n' 'Detected administrator tooling: Bash, SSH and Ansible are available. No action is needed for these tools.'
printf '%s\n' '' 'This guided setup has five steps:' \
  '  1. Connect to the Raspberry Pi and check administrator access.' \
  '  2. Confirm the trusted home network.' \
  '  3. Find connected printers and scanners.' \
  '  4. Choose the devices and their settings.' \
  '  5. Review everything before the Raspberry Pi is changed.' \
  'You can stop with Ctrl+C at any time. Nothing is configured until the final confirmation.'

stage '1/5' 'Connect to Your Raspberry Pi' 'Use the DHCP-reserved address or stable local DNS name so onboarding can find the same Raspberry Pi again later.'
host_default='print-server.local'
administrator_cidr=$(administrator_lan_cidr || true)
if [[ -n "$administrator_cidr" ]]; then
  printf 'Detected administrator network: %s. The optional search checks a private /24 range for SSH servers on port 22. It does not authenticate or change any device.\n' "$administrator_cidr"
else
  printf '%s\n' 'The administrator machine network could not be detected automatically. You can enter a private /24 range to search, or enter the Raspberry Pi address manually.'
fi
if yes 'Search a network for possible Raspberry Pi SSH servers?'; then
  while true; do
    if [[ -n "$administrator_cidr" ]]; then
      search_cidr=$(ask_detected 'Private IPv4 network to search' "$administrator_cidr" 'Enter another private /24 range only when the Raspberry Pi is on a different routed VLAN.')
    else
      printf '%s\n' 'Enter the network range that contains the Raspberry Pi, for example 192.168.178.0/24. Only private /24 ranges are accepted.'
      search_cidr=$(ask 'Private IPv4 network to search' '')
    fi
    valid_private_ipv4_24_cidr "$search_cidr" && break
    printf '%s\n' 'Invalid network range. Use a private /24 network ending in .0/24, for example 192.168.178.0/24.' >&2
  done
  if ! ssh_port_probe_available; then
    printf '%s\n' 'Automatic search needs netcat (nc) or timeout on this administrator machine. Enter the Raspberry Pi address manually.' >&2
  else
    printf 'Searching %s now. This normally takes about 20 seconds.\n' "$search_cidr"
    ssh_hosts=()
    while IFS= read -r ssh_host; do
      [[ -n "$ssh_host" ]] && ssh_hosts+=("$ssh_host")
    done < <(find_ssh_hosts "$search_cidr")
    if (( ${#ssh_hosts[@]} == 0 )); then
      printf '%s\n' 'No SSH servers were detected. The Raspberry Pi may be offline, outside this /24 network or have SSH disabled. Enter its address manually.'
    elif (( ${#ssh_hosts[@]} == 1 )); then
      host_default=${ssh_hosts[0]}
      printf 'Detected one possible Raspberry Pi SSH server: %s. Press Enter below if this is the Raspberry Pi.\n' "$host_default"
    else
      printf '%s\n' 'Detected multiple SSH servers. Select the Raspberry Pi explicitly; the list can include other computers or network appliances.'
      candidate_count=0
      discovered_host=$(choose_candidate 'Possible SSH servers' "${ssh_hosts[@]}")
      [[ "$discovered_host" != manual ]] && host_default=$discovered_host
    fi
  fi
fi
host=$(ask 'Raspberry Pi hostname or IP address' "$host_default")
if ! ssh_session_target_resolves; then
  printf '%s\n' 'That Raspberry Pi address cannot be found on this computer.' >&2
  printf '%s\n' 'Use the DHCP-reserved IPv4 address, for example 192.168.178.33, or a stable local name such as print-server.local.' >&2
  exit 1
fi
printf '%s\n' 'Use the administrator account created in Raspberry Pi Imager. It is the account that installs and maintains printing services.'
admin=$(ask 'Raspberry Pi Imager bootstrap user' 'printadmin')
printf '%s\n' 'Connecting now. On a first connection, confirm the Raspberry Pi host key. Then enter its password when SSH asks.'
if ! ssh_session_open; then
  printf '%s\n' 'SSH authentication failed. Check the Raspberry Pi address, bootstrap user, password and that Raspberry Pi Imager enabled password SSH.' >&2
  exit 1
fi
trap cleanup EXIT
trap 'exit 130' INT TERM
if ! remote true; then
  printf '%s\n' 'SSH connected but the remote session could not run a command. Check the Raspberry Pi SSH service and user shell.' >&2
  exit 1
fi
printf 'SSH connection succeeded: %s@%s.\n' "$admin" "$host"
printf '%s\n' 'Next, sudo checks that this account may install packages and manage services. Enter the same Raspberry Pi password if prompted.'
if ! remote_tty 'sudo -v'; then
  printf '%s\n' 'Sudo verification failed. Use the administrator account created in Raspberry Pi Imager or grant it sudo access before rerunning.' >&2
  exit 1
fi
printf '%s\n' 'Sudo access succeeded. The password is not stored.'
stage '2/5' 'Confirm Your Trusted Network' 'Reading the Raspberry Pi network, timezone and locale now. Only devices on the trusted network will later reach printing and scanning.'
suggested_cidr=$(remote "ip -4 route get 1.1.1.1 | awk '{for (i=1;i<=NF;i++) if (\$i==\"src\") print \$(i+1)}'" 2>/dev/null | awk -F. 'NF==4 {printf "%s.%s.%s.0/24", $1,$2,$3; exit}')
timezone=$(remote 'cat /etc/timezone 2>/dev/null || timedatectl show --property=Timezone --value' 2>/dev/null || true)
locale=$(remote "locale | awk -F= '/^LANG=/{print \$2; exit}'" 2>/dev/null || true)
timezone=${timezone:-"$(saved_scalar common_timezone Europe/Berlin)"}
locale=${locale:-"$(saved_scalar common_locale en_US.UTF-8)"}
printf 'Detected Raspberry Pi settings: IPv4 network %s, timezone %s, locale %s.\n' "${suggested_cidr:-not detected}" "$timezone" "$locale"
printf '%s\n' 'The detected timezone and locale were set in Raspberry Pi Imager and will be kept. No input is needed for them.'
printf '%s\n' 'Choose the normal home-LAN subnet. A CIDR is the whole network range, for example 192.168.178.0/24, not the Raspberry Pi address. Accept the suggestion unless printing clients use another trusted VLAN.'
while true; do
  cidr=$(ask_detected 'Trusted IPv4 LAN CIDR' "${suggested_cidr:-192.168.1.0/24}" 'Do not enter the Raspberry Pi address itself.')
  valid_ipv4_cidr "$cidr" && break
  printf '%s\n' 'Invalid IPv4 CIDR. Use four numbers from 0 to 255 followed by /0 to /32, for example 192.168.178.0/24.' >&2
done
printf '%s\n' 'Leave IPv6 empty unless the home network actively uses a known local IPv6 prefix.'
while true; do
  ipv6_cidr=$(ask 'Optional trusted IPv6 CIDR' '')
  [[ -z "$ipv6_cidr" ]] || valid_ipv6_cidr "$ipv6_cidr" && break
  printf '%s\n' 'Invalid IPv6 CIDR. Use a local IPv6 prefix followed by /0 to /128, or leave it empty.' >&2
done
stage '3/5' 'Find Printers and Scanners' 'Discovery can suggest settings for devices on this trusted LAN and directly connected USB devices. It never selects or configures a device without you.'
discover_devices
stage '4/5' 'Choose Your Devices' 'The selections here become the saved configuration used for later maintenance. Keep the suggested names unless another name is clearer in your home network.'
hostname=$(ask 'Server hostname' "$(saved_scalar common_hostname print-server)")
subsection 'Printer 1'
printf '%s\n' 'The queue name is what phones, computers and tablets will see when choosing this printer.'
queue=$(ask 'CUPS queue name' 'printer')
printf 'Timezone and locale are inherited from Raspberry Pi Imager: %s, %s.\n' "$timezone" "$locale"
printf '%s\n' 'Choose how this device reaches the Raspberry Pi. This controls which discovery and connection settings are used.'
printf '%s\n' 'Connection preference, when the device supports it:' \
  '  1. network: Ethernet through the router or switch. This is the simplest path and can support standard printing and scanning.' \
  '  2. direct_ethernet: Ethernet directly to an unused Raspberry Pi port when the device cannot reach the router.' \
  '  3. usb: a fallback that often supports printing; scanning needs a usable Linux SANE backend.'
recommendation 'Choose network for a device on the home LAN. The wizard detects the capabilities the device actually provides and does not promise scanning for every connection type.'
topology=$(ask_choice 'Device connection topology' 'network' network direct_ethernet usb)
if [[ "$topology" == direct_ethernet ]]; then
  recommendation 'Use a private /30 link. The Pi will use 192.168.50.1 and the device must be set once to 192.168.50.2 on its own control panel or web interface.'
  active_interface=$(remote "ip -4 route get 1.1.1.1 | awk '{for (i=1;i<=NF;i++) if (\$i==\"dev\") print \$(i+1)}'" 2>/dev/null || true)
  while true; do
    direct_ethernet_interface=$(ask 'Unused Raspberry Pi Ethernet interface' 'eth0')
    [[ "$direct_ethernet_interface" != "$active_interface" ]] && break
    printf 'Interface %s carries the Raspberry Pi default route and cannot be used for the private device link. Choose another interface.\n' "$direct_ethernet_interface" >&2
  done
  while true; do
    direct_ethernet_pi_ipv4_cidr=$(ask 'Raspberry Pi private IPv4 CIDR' '192.168.50.1/30')
    valid_ipv4_cidr "$direct_ethernet_pi_ipv4_cidr" && break
    printf '%s\n' 'Enter a valid IPv4 CIDR, for example 192.168.50.1/30.' >&2
  done
  while true; do
    direct_ethernet_device_ipv4=$(ask 'Device static IPv4 address' '192.168.50.2')
    same_direct_ipv4_link "$direct_ethernet_pi_ipv4_cidr" "$direct_ethernet_device_ipv4" && break
    printf '%s\n' 'Enter another address in the same /30 link as the Raspberry Pi, for example 192.168.50.2.' >&2
  done
  discover_direct_ethernet_device
  printf '%s\n' 'The direct Ethernet link is recreated permanently only after final confirmation. Commissioning then verifies the declared device before creating its queue or scanner service.'
fi
if [[ "$topology" == usb ]]; then
  connection=usb
  printf '%s\n' 'USB was selected. The wizard will use the local USB identity and only configures scanning when a usable SANE device is detected.'
else
  printf '%s\n' 'Choose ipp for most modern network printers. Use ipps for encrypted IPP, socket for JetDirect printers (usually port 9100) or lpd for older LPD printers.'
  [[ -n "${discovered_printer_connection:-}" && "$topology" == network ]] && recommendation "Keep the detected ${discovered_printer_connection} connection if it matches the intended printer."
  connection=$(ask_choice 'Printer connection' "${discovered_printer_connection:-ipp}" ipp ipps socket lpd)
fi
printf '%s\n' 'The device URI tells CUPS where this printer is. For IPP, a common example is ipp://192.168.178.50/ipp/print. Find the exact URI in the printer web administration page or manual, then keep a discovered value unless it is wrong.'
[[ -n "${discovered_printer_uri:-}" ]] && printf 'Detected printer URI: %s. Press Enter to keep it if it matches the intended printer.\n' "$discovered_printer_uri"
uri_default=${discovered_printer_uri:-ipp://printer.local/ipp/print}
[[ "$topology" == direct_ethernet ]] && uri_default="ipp://${direct_ethernet_device_ipv4}/ipp/print"
uri=$(ask 'Printer device URI' "$uri_default")
usb_mode=''
usb_identity=''
if [[ "$connection" == usb ]]; then
  printf '%s\n' 'Choose ipp_usb only for an IPP-over-USB capable driverless printer. Choose legacy_usb for a package-profile printer. The final run checks the connected device before enabling ipp-usb.'
  usb_mode=$(ask_choice 'USB mode' "${discovered_printer_usb_mode:-ipp_usb}" ipp_usb legacy_usb)
  if ! usb_identity=$(choose_usb_identity "$(remote 'lsusb' 2>&1 || true)"); then
    printf '%s\n' 'No USB identity could be detected automatically. Enter the four-digit vendor and product values after ID from lsusb, for example ID 04a9:1909 becomes 04a9:1909.' >&2
    usb_identity=$(ask 'USB vendor:product identity from lsusb' '')
  elif [[ "$usb_identity" == manual ]]; then
    usb_identity=$(ask 'USB vendor:product identity from lsusb' '')
  fi
fi
printf '%s\n' 'Choose driverless first. It uses the printer built-in IPP support and needs no manufacturer driver. Choose package_profile only for an older printer that needs an installed driver package.'
driver=$(ask_choice 'Printer driver mode' 'driverless' driverless package_profile)
profile=''
printer_make=''
printer_model=''
if [[ "$driver" == package_profile ]]; then
  printer_make=$(ask 'Printer manufacturer for advisory lookup' '')
  printer_model=$(ask 'Printer model for advisory lookup' '')
  profile=$(ask 'Explicit package profile' 'brlaser')
fi
printer_queues=("$queue")
printer_connections=("$connection")
printer_uris=("$uri")
printer_drivers=("$driver")
printer_profiles=("$profile")
printer_usb_modes=("$usb_mode")
printer_usb_identities=("$usb_identity")
subsection 'Additional Devices'
printf '%s\n' 'Add another printer or scanner only when it should be managed separately.'
while yes 'Add another printer manually?'; do
  printf '%s\n' 'This printer will have its own queue in the print dialog.'
  extra_queue=$(ask 'Additional CUPS queue name' 'printer-2')
  recommendation 'Choose network for another home-LAN device or usb for another USB-local device. A direct Ethernet /30 link is reserved for one device.'
  extra_topology=$(ask_choice 'Additional device connection topology' 'network' network usb)
  if [[ "$extra_topology" == usb ]]; then
    extra_connection=usb
  else
    extra_connection=$(ask_choice 'Printer connection' 'ipp' ipp ipps socket lpd)
  fi
  printf '%s\n' 'For IPP, use the URI from the printer web administration page or manual, for example ipp://192.168.178.50/ipp/print.'
  extra_uri=$(ask 'Printer device URI' 'ipp://printer.local/ipp/print')
  extra_usb_mode=''
  extra_usb_identity=''
  if [[ "$extra_connection" == usb ]]; then
    extra_usb_mode=$(ask_choice 'USB mode' 'ipp_usb' ipp_usb legacy_usb)
    if ! extra_usb_identity=$(choose_usb_identity "$(remote 'lsusb' 2>&1 || true)"); then
      printf '%s\n' 'No USB identity could be detected automatically. Enter the four-digit vendor and product values after ID from lsusb, for example ID 04a9:1909 becomes 04a9:1909.' >&2
      extra_usb_identity=$(ask 'USB vendor:product identity from lsusb' '')
    elif [[ "$extra_usb_identity" == manual ]]; then
      extra_usb_identity=$(ask 'USB vendor:product identity from lsusb' '')
    fi
  fi
  extra_driver=$(ask_choice 'Printer driver mode' 'driverless' driverless package_profile)
  extra_profile=''
  [[ "$extra_driver" == package_profile ]] && extra_profile=$(ask 'Explicit package profile' 'brlaser')
  [[ "$extra_queue" =~ ^[A-Za-z0-9_.-]+$ ]] || { printf '%s\n' 'Invalid queue name.' >&2; exit 1; }
  [[ "$extra_connection" != usb || "$extra_usb_identity" =~ ^[0-9A-Fa-f]{4}:[0-9A-Fa-f]{4}$ ]] || { printf '%s\n' 'USB identity must use vendor:product form.' >&2; exit 1; }
  printer_queues+=("$extra_queue")
  printer_connections+=("$extra_connection")
  printer_uris+=("$extra_uri")
  printer_drivers+=("$extra_driver")
  printer_profiles+=("$extra_profile")
  printer_usb_modes+=("$extra_usb_mode")
  printer_usb_identities+=("$extra_usb_identity")
done

scanner=false
subsection 'Optional Scanner'
if [[ "${discovered_scanner:-false}" == true ]]; then
  scanner=true
  scanner_connection=$discovered_scanner_connection
  scanner_backend=$discovered_scanner_backend
  scanner_uri=''
  scanner_usb_mode=$discovered_scanner_usb_mode
else
  printf '%s\n' 'Choose a scanner only when it is connected. Browser scanning is the normal cross-platform option and lets users choose from configured scanners.'
  if yes 'Configure a scanner?'; then
    scanner=true
    scanner_connection=$(ask_choice 'Scanner connection' 'ipp' usb ipp ipps)
    printf '%s\n' 'Use sane-airscan for most network scanners. It supports modern eSCL and WSD scanning. Use sane-utils for a legacy USB scanner, or enter its documented backend package.'
    scanner_backend=$(ask 'SANE backend package' 'sane-airscan')
    scanner_uri=$(ask 'Optional scanner device URI' '')
    scanner_usb_mode=''
    [[ "$scanner_connection" == usb ]] && scanner_usb_mode=$(ask_choice 'Scanner USB mode' 'ipp_usb' ipp_usb legacy_usb)
  fi
fi
if [[ "$scanner" == true ]]; then
  printf '%s\n' 'The SANE device name identifies this exact scanner. On the Raspberry Pi, run scanimage -L and copy the text inside the quotes after device, for example airscan:e0:Office_Scanner.'
  scanner_device_name=$(ask 'Exact SANE device name from scanimage -L' "${discovered_scanner_device_name:-}")
  printf '%s\n' 'Choose 90 days as a starting point. Completed scans are visible to the trusted LAN until this period expires.'
  retention=$(ask 'Scan retention days (1-900, recommended 90)' '90')
  printf '%s\n' 'OCR makes scanned PDFs searchable. Use eng for English. Add deu for German, separated with commas. More languages can make OCR slower.'
  ocr=$(ask 'OCR language codes, comma-separated' 'eng')
  [[ "$retention" =~ ^[0-9]+$ ]] && (( retention >= 1 && retention <= 900 )) || { printf '%s\n' 'Retention must be 1 to 900 days.' >&2; exit 1; }
fi
scanner_device_names=()
scanner_connections=()
scanner_backends=()
scanner_usb_modes=()
if [[ "$scanner" == true ]]; then
  scanner_device_names+=("$scanner_device_name")
  scanner_connections+=("$scanner_connection")
  scanner_backends+=("$scanner_backend")
  scanner_usb_modes+=("$scanner_usb_mode")
fi
while yes 'Add another scanner manually?'; do
  printf '%s\n' 'On the Raspberry Pi, run scanimage -L and copy the text inside the quotes after device.'
  extra_scanner_name=$(ask 'Exact SANE device name from scanimage -L' '')
  extra_scanner_connection=$(ask_choice 'Scanner connection' 'ipp' usb ipp ipps)
  printf '%s\n' 'Use sane-airscan for most network scanners, sane-utils for a legacy USB scanner, or its documented backend package.'
  extra_scanner_backend=$(ask 'SANE backend package' 'sane-airscan')
  extra_scanner_usb_mode=''
  [[ "$extra_scanner_connection" == usb ]] && extra_scanner_usb_mode=$(ask_choice 'Scanner USB mode' 'ipp_usb' ipp_usb legacy_usb)
  [[ -n "$extra_scanner_name" ]] || { printf '%s\n' 'Scanner device name is required.' >&2; exit 1; }
  scanner_device_names+=("$extra_scanner_name")
  scanner_connections+=("$extra_scanner_connection")
  scanner_backends+=("$extra_scanner_backend")
  scanner_usb_modes+=("$extra_scanner_usb_mode")
done
if (( ${#scanner_device_names[@]} > 0 )) && [[ "$scanner" != true ]]; then
  retention=$(ask 'Scan retention days (1-900, recommended 90)' '90')
  ocr=$(ask 'OCR language codes, comma-separated' 'eng')
  [[ "$retention" =~ ^[0-9]+$ ]] && (( retention >= 1 && retention <= 900 )) || { printf '%s\n' 'Retention must be 1 to 900 days.' >&2; exit 1; }
fi
[[ "$hostname" =~ ^[a-zA-Z0-9][a-zA-Z0-9-]{0,62}$ ]] || { printf '%s\n' 'Invalid hostname.' >&2; exit 1; }
[[ "$queue" =~ ^[A-Za-z0-9_.-]+$ ]] || { printf '%s\n' 'Invalid queue name.' >&2; exit 1; }
[[ "$connection" != usb || "$usb_mode" == ipp_usb || "$usb_mode" == legacy_usb ]] || { printf '%s\n' 'Invalid printer USB mode.' >&2; exit 1; }
[[ "$connection" != usb || "$usb_identity" =~ ^[0-9A-Fa-f]{4}:[0-9A-Fa-f]{4}$ ]] || { printf '%s\n' 'USB identity must use vendor:product form.' >&2; exit 1; }
[[ "$scanner" != true || -n "$scanner_device_name" ]] || { printf '%s\n' 'Scanner device name is required.' >&2; exit 1; }
declare -A queue_names=()
for queue in "${printer_queues[@]}"; do
  [[ -z "${queue_names[$queue]:-}" ]] || { printf 'Duplicate queue name: %s\n' "$queue" >&2; exit 1; }
  queue_names[$queue]=true
done
[[ "$scanner" != true || "$scanner_connection" != usb || "$scanner_usb_mode" == ipp_usb || "$scanner_usb_mode" == legacy_usb ]] || { printf '%s\n' 'Invalid scanner USB mode.' >&2; exit 1; }

stage '5/5' 'Review and Commission' 'Review the configuration below before it is written locally or applied to the Raspberry Pi.'
printf 'Pi: %s\nTrusted LAN: %s\nPrinters: %s\n' "$host" "$cidr" "${printer_queues[*]}"
(( ${#scanner_device_names[@]} > 0 )) && printf 'Scanners: %s, retention %s days, OCR %s\n' "${scanner_device_names[*]}" "$retention" "$ocr"
printf '%s\n' 'Confirmation creates local inventory backups, replaces the declared device lists and starts Ansible provisioning on the Raspberry Pi.'
printf '%s\n' 'No passwords are written to inventory. Choose no to exit without changing inventory or Raspberry Pi services.'
yes 'Write production inventory and commission this Pi?' || exit 0

mkdir -p "$backups" "$(dirname "$variables")"
stamp=$(date +%Y%m%d-%H%M%S)
for file in "$inventory" "$variables"; do [[ -f "$file" ]] && cp "$file" "$backups/$(basename "$file").$stamp"; done
host_tmp=$(mktemp "$inventory.XXXXXX")
vars_tmp=$(mktemp "$variables.XXXXXX")
printf '%s\n' '---' 'all:' '  children:' '    print_servers:' '      hosts:' '        print-server:' "          ansible_host: $(quote "$host")" "          ansible_user: $(quote "$admin")" '          ansible_become: true' >"$host_tmp"
{
  printf '%s\n' '---'
  printf 'common_hostname: %s\ncommon_timezone: %s\ncommon_locale: %s\n' "$(quote "$hostname")" "$(quote "$timezone")" "$(quote "$locale")"
  printf 'managed_users:\n  - name: %s\n    groups: [sudo]\n    sudo: true\n' "$(quote "$admin")"
  printf 'ssh_allow_password_authentication: true\nfirewall_enabled: true\ntrusted_lan_cidrs:\n  - %s\n' "$(quote "$cidr")"
  [[ -n "$ipv6_cidr" ]] && printf '  - %s\n' "$(quote "$ipv6_cidr")"
  if [[ -n "$direct_ethernet_interface" ]]; then
    printf 'direct_ethernet_links:\n  - interface: %s\n    pi_ipv4_cidr: %s\n    device_ipv4: %s\n' \
      "$(quote "$direct_ethernet_interface")" "$(quote "$direct_ethernet_pi_ipv4_cidr")" "$(quote "$direct_ethernet_device_ipv4")"
  else
    printf '%s\n' 'direct_ethernet_links: []'
  fi
  printf '%s\n' 'managed_printers:'
  for index in "${!printer_queues[@]}"; do
    printf '  - name: %s\n    connection: %s\n    device_uri: %s\n    driver_mode: %s\n    shared: true\n' \
      "$(quote "${printer_queues[$index]}")" "$(quote "${printer_connections[$index]}")" \
      "$(quote "${printer_uris[$index]}")" "$(quote "${printer_drivers[$index]}")"
    [[ -n "${printer_profiles[$index]}" ]] && printf '    package_profile: %s\n' "$(quote "${printer_profiles[$index]}")"
    [[ -n "${printer_usb_modes[$index]}" ]] && printf '    usb_mode: %s\n' "$(quote "${printer_usb_modes[$index]}")"
    [[ -n "${printer_usb_identities[$index]}" ]] && printf '    usb_identity: %s\n' "$(quote "${printer_usb_identities[$index]}")"
  done
  if (( ${#scanner_device_names[@]} > 0 )); then
    languages=$(printf '%s' "$ocr" | sed 's/[[:space:]]*,[[:space:]]*/, /g; s/[^, ][^, ]*/"&"/g')
    printf '%s\n' 'managed_scanners:'
    for index in "${!scanner_device_names[@]}"; do
      printf '  - device_name: %s\n    connection: %s\n    backend: %s\n' \
        "$(quote "${scanner_device_names[$index]}")" "$(quote "${scanner_connections[$index]}")" "$(quote "${scanner_backends[$index]}")"
      [[ -n "${scanner_usb_modes[$index]}" ]] && printf '    usb_mode: %s\n' "$(quote "${scanner_usb_modes[$index]}")"
    done
    printf 'scanservjs_retention_days: %s\nscanservjs_ocr_languages: [%s]\n' "$retention" "$languages"
  else
    printf '%s\n' 'managed_scanners: []'
  fi
  printf '%s\n' 'enable_remote_sane: false' 'automatic_os_updates: false'
} >"$vars_tmp"
mv "$host_tmp" "$inventory"
mv "$vars_tmp" "$variables"
host_tmp=''
vars_tmp=''
subsection 'Applying Your Configuration'
printf '%s\n' 'Your confirmed choices are now being applied. Ansible will show its normal progress while it installs services and configures the declared queues and scanners.'
ansible-galaxy collection install -r "$root/requirements.yml"
[[ "$driver" == package_profile ]] && { printf '%s\n' 'Running legacy-printer advisory discovery.'; ansible-playbook -i "$inventory" "$root/playbooks/discover-printer.yml"; }
ansible-playbook -i "$inventory" "$root/playbooks/site.yml" -e print_server_commissioning=true
printf '%s\n' 'Commissioning completed successfully.'
if yes 'Print CUPS test pages now?'; then
  for queue in "${printer_queues[@]}"; do
    printf 'Submitting test page to %s.\n' "$queue"
    remote "lp -d $(printf '%q' "$queue") /usr/share/cups/data/testprint"
  done
fi
if (( ${#scanner_device_names[@]} > 0 )) && yes 'Create scanner test PDFs now?'; then
  for scanner_device_name in "${scanner_device_names[@]}"; do
    printf 'Creating scanner test PDF for %s.\n' "$scanner_device_name"
    remote "scanimage -d $(printf '%q' "$scanner_device_name") --format=pdf > /var/tmp/scanservjs-onboarding-test.pdf"
  done
  printf 'Created scanner test PDFs on %s.\n' "$host"
fi
