#!/usr/bin/env bash
set -euo pipefail

root=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
source "$root/scripts/lib/onboarding/prompts.sh"

if [[ ! -x "$root/.venv/bin/ansible-lint" ]]; then
  "$root/scripts/setup"
fi

export PATH="$root/.venv/bin:$PATH"
export ANSIBLE_LOCAL_TEMP="${TMPDIR:-/tmp}/raspberry-print-server-ansible-local"
export ANSIBLE_REMOTE_TEMP="${TMPDIR:-/tmp}/raspberry-print-server-ansible-remote"
export XDG_CACHE_HOME="${TMPDIR:-/tmp}/raspberry-print-server-cache"
mkdir -p "$ANSIBLE_LOCAL_TEMP" "$ANSIBLE_REMOTE_TEMP" "$XDG_CACHE_HOME"

printf '%s\n' 'Repository checks'

group_header 'Bash syntax and module tests'
bash -n "$root/start" "$root/scripts/onboard" "$root/scripts/manage-devices" "$root/scripts/setup" \
  "$root/scripts/qa" "$root/scripts/lib/onboarding/"*.sh "$root/test/"*.sh
for test_script in "$root/test/"*.sh; do
  bash "$test_script"
done
for python_test in "$root/test/"*_test.py; do
  python "$python_test"
done
setup_status 'Bash syntax and module tests passed'

printf '\n'
group_header 'YAML and Ansible conventions'
cd "$root"
yamllint .
ansible-lint
setup_status 'YAML and Ansible conventions passed'

printf '\n'
group_header 'Playbook syntax'
for playbook in playbooks/*.yml; do
  ansible-playbook "$playbook" --syntax-check
done
setup_status 'Every playbook passed its syntax check'

printf '\n'
printf '%s\n' 'All repository checks passed.'
