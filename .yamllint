---
extends: default

# Generated catalog artifacts are machine-written and validated by
# test/driver_catalog_test.py; their long provenance lines would trip line-length.
ignore: |
  .ansible/
  .onboard-backups/
  .venv/
  collections/
  inventories/production/
  vars/generated/

rules:
  braces:
    max-spaces-inside: 1
  comments:
    min-spaces-from-content: 1
  comments-indentation: false
  document-start: disable
  line-length:
    max: 120
  octal-values:
    forbid-implicit-octal: true
    forbid-explicit-octal: true
  truthy:
    allowed-values: ['true', 'false']
